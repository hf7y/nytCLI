#!/bin/bash
set -euo pipefail

SECTION="home"
LIMIT=0

while getopts s:l:a: opts; do
    case ${opts} in
        s) SECTION=${OPTARG} ;;
        l) LIMIT=${OPTARG} ;;
        a) API=${OPTARG} ;;
    esac
done

KEYFILE="${XDG_CONFIG_HOME:-$HOME/.config}/nytcli/api_key"
if [ -z "${API:-}" ]; then
    API="${NYTCLI_API_KEY:-}"
fi
if [ -z "${API:-}" ] && [ -r "$KEYFILE" ]; then
    API=$(<"$KEYFILE")
fi

if [ -z "${API:-}" ]; then
    echo "Usage: nytcli -a <nyt-api-key> [-s section] [-l limit]" >&2
    echo "Sections: arts, business, movies, politics, science, sports, technology, us, world, ... (see NYT docs)" >&2
    echo "Get a key at https://developer.nytimes.com/" >&2
    echo >&2
    echo "To skip -a every time, either:" >&2
    echo "  export NYTCLI_API_KEY=your_key   (e.g. in ~/.bashrc)" >&2
    echo "  or: mkdir -p $(dirname "$KEYFILE") && echo your_key > $KEYFILE && chmod 600 $KEYFILE" >&2
    exit 1
fi

URL="https://api.nytimes.com/svc/topstories/v2/${SECTION}.json?api-key=${API}"

RESP=$(curl -s "$URL") || { echo "nytcli: request failed" >&2; exit 1; }

STATUS=$(echo "$RESP" | jq -r '.status // "error"')
if [ "$STATUS" != "OK" ]; then
    echo "nytcli: ${STATUS}: $(echo "$RESP" | jq -r '.fault.faultstring // .message // "unknown error"')" >&2
    exit 1
fi

echo "$RESP" | jq -r --argjson limit "$LIMIT" '
    .results
    | (if $limit > 0 then .[:$limit] else . end)
    | .[]
    | .title, .abstract
' | awk '

BEGIN {
    # Create horizontal ruler
    RULER="-"
    for(i = 1; i<= 77; i++)
        RULER = RULER "-"
    # Variable with title color (yellow on black)
    TEXTCOL="\033[0;93m\033[40m"
    # Variable to reset text color
    NC="\033[0m"
}
# Print title
NR % 2 { print TEXTCOL $0 NC }

# Print abstract and horizontal ruler
!(NR % 2) { print $0 "\n" RULER }

' | fmt -s -w 78
